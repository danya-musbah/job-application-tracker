# Copy this file to .env and fill in real values before running in production.

# Port the backend API server listens on.
PORT=4000

# Port the (optional) static frontend dev server listens on.
FRONTEND_PORT=5500

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=./data/app.db

# Environment: development | production
NODE_ENV=development

# Secret used to sign JWT auth tokens. MUST be a long, random, unguessable
# string in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# How long an issued auth token stays valid.
JWT_EXPIRES_IN=7d

# Name of the httpOnly cookie used to store the auth token.
SESSION_COOKIE_NAME=jat_token

# Exact origin the frontend is served from. Used for CORS - must match
# exactly (protocol + host + port), never a wildcard, since the API uses
# authenticated cookies.
FRONTEND_URL=http://localhost:5500
